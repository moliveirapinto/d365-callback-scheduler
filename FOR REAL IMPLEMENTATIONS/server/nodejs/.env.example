# Copy this file to `.env` (same folder) and fill in your values.
# NEVER commit the real .env to git.

DV_ORG_URL=https://yourorg.crm.dynamics.com
AAD_TENANT_ID=00000000-0000-0000-0000-000000000000
AAD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AAD_CLIENT_SECRET=replace-with-the-secret-value-from-entra

# Optional. If blank, the bridge auto-discovers the first config.
DV_PROACTIVE_CONFIG_ID=

# Optional. Set to your public website origin so browsers from other origins are rejected.
# Example: https://www.acme.com
ALLOWED_ORIGIN=

# Optional. Defaults to 3000.
PORT=3000
